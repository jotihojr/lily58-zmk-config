#include <behaviors.dtsi>
#include <behaviors/num_word.dtsi> // Requires zmk-auto-layer module.
#include <zmk-helpers/helper.h> // Requires zmk-helpers module.
#include <dt-bindings/zmk/keys.h>

#define MAGIC_SHIFT &magic_shift LSHFT 0

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                                      \
    ZMK_LAYER(                                                                                    \
        name,                                                                                     \
    &kp ESC       &kp N1        &kp N2        &kp N3        &kp N4        &kp N5                                      &kp N6        &kp N7        &kp N8        &kp N9        &kp N0        &kp MINUS   \
    &kp GRAVE                                     LT                                                                                                  RT                                    &kp BSPC    \
    &kp TAB                                       LM                                                                                                  RM                                    &kp SQT     \
    &none                                         LB                                    &kp LBKT        &kp RBKT                                      RB                                    &kp EQUAL   \
                                              &none         MAGIC_SHIFT            LH                              RH               MAGIC_SHIFT   &none)

#define CONFIG_WIRELESS
#define LILY58_STANDARD_LABELS
#include "zmk-helpers/key-labels/lily58.h"
#include "base.keymap"

